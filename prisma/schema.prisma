// Schema do PetDots. Os models derivam do DOMAIN_MODEL (docs/01-product/),
// nunca do marketplace legado (ADR-0002, anti-contaminação).
// Os models nascem a partir da pd-09: `WaitlistEntry` é o primeiro, e com ele
// a primeira migration do projeto. Os demais agregados do DOMAIN_MODEL entram
// junto com a feature que os exercita, nunca antes — `Product`, `Store`,
// `DeliveryArea` e `Offer` entraram na pd-11, com o comparador público, e
// `CommissionRate` ficou de fora porque quem a lê é `orders` (ADR-0010).
// `User` e `RefreshToken` entraram na pd-12, com a autenticação própria;
// `Tutor` não veio junto, porque é perfil de consumo e não identidade
// (ADR-0011, A10). `Tutor` e `Pet` entraram na pd-14, com o perfil do tutor e
// o cadastro de pets — o passo seguinte ao cadastro, não parte dele
// (ADR-0015). `ReplenishmentSchedule` e `Reminder` continuam fora: quem os lê
// é a calculadora de consumo (capacidade 9).

generator client {
  provider = "prisma-client-js"
}

// A URL de conexão não vive mais aqui: no Prisma 7 ela é do `prisma.config.ts`
// (para Migrate) e do driver adapter (para o client em runtime). Ver ADR-0007.
datasource db {
  provider = "postgresql"
}

enum WaitlistSource {
  CAMPAIGN
  OUT_OF_AREA
  STORE_QR

  @@map("waitlist_source")
}

/// Smoke-test and out-of-area captures (DOMAIN_MODEL §Lista de Espera).
/// `phone` is the lead's identity: normalised to E.164 by the domain and
/// unique here, so the same person never counts twice (pd-09, A9).
model WaitlistEntry {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String         @db.VarChar(120)
  phone           String         @unique @db.VarChar(16)
  neighborhood    String         @db.VarChar(80)
  postalCode      String         @map("postal_code") @db.Char(8)
  petFoodDeclared String?        @map("pet_food_declared") @db.VarChar(120)
  source          WaitlistSource
  consentAt       DateTime       @map("consent_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@map("waitlist_entries")
}

enum UserRole {
  TUTOR
  STORE_MEMBER
  ADMIN

  @@map("user_role")
}

/// Authenticable identity (DOMAIN_MODEL §Usuário). One human is one row even
/// when they are both a tutor and a shop owner — `roles` is a list precisely
/// because "a identidade é uma só, os papéis se acumulam".
/// `Tutor` (the consumption profile: pets, addresses, schedules) is a separate
/// aggregate, optional and 1:1: registering still creates a `User` and nothing
/// else (ADR-0011 A10), and the profile arrives in a later step (ADR-0015).
/// `phone` is written by that step, through a use case of `identity` — the
/// `tutors` module never touches this table.
model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(16)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  roles        UserRole[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  tutor         Tutor?

  @@map("users")
}

enum PetSpecies {
  DOG
  CAT

  @@map("pet_species")
}

/// Consumption profile of a `User` (DOMAIN_MODEL §Tutor): who to deliver to.
/// One row per identity — `user_id` is unique, which is what makes `PUT
/// /tutors/me` an upsert with nothing to reconcile.
/// `default_address` of the DOMAIN_MODEL is these flat columns and not a child
/// table: the MVP has one address per tutor, `neighborhood` and `postal_code`
/// are queried, and the order stores its own snapshot, so address history never
/// needs a table (ADR-0015). `phone` is not here — it belongs to the identity.
model Tutor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  name         String   @db.VarChar(120)
  street       String   @db.VarChar(160)
  streetNumber String   @map("street_number") @db.VarChar(20)
  complement   String?  @db.VarChar(80)
  neighborhood String   @db.VarChar(80)
  postalCode   String   @map("postal_code") @db.Char(8)
  reference    String?  @db.VarChar(160)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pets Pet[]

  @@map("tutors")
}

/// A tutor's animal (DOMAIN_MODEL §Pet). `id` is the **Pet ID** and is
/// immutable — it is what the phase-2 pet wallet will hang off.
/// `birth_date` is a `DATE` and nullable: many tutors do not know it, and
/// blocking the registration over it would contradict "poucas telas, pouco
/// esforço" (PERSONAS). `weight_grams` is the input the consumption calculator
/// will read (capacidade 9); its `> 0` check is written by hand in the
/// migration, because Prisma does not model check constraints.
model Pet {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId     String     @map("tutor_id") @db.Uuid
  name        String     @db.VarChar(60)
  species     PetSpecies
  birthDate   DateTime?  @map("birth_date") @db.Date
  weightGrams Int        @map("weight_grams")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("pets")
}

/// A refresh token that can be revoked. Persisting it is what makes logout
/// mean something: an access token expires on its own, but a refresh token
/// nobody tracks can never be taken back (AUTHENTICATION, ADR-0011 A7).
/// Only the hash is stored — the column is a credential verifier, not the
/// credential, exactly like `users.password_hash`.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ProductCategory {
  FOOD_STANDARD
  FOOD_PREMIUM
  TREAT
  HYGIENE
  HEALTH_OTC
  ACCESSORY

  @@map("product_category")
}

enum StoreStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED

  @@map("store_status")
}

/// Master catalogue, curated by the platform (DOMAIN_MODEL §Produto). A store
/// never creates a product — it declares an `Offer` over one.
/// `slug` and `searchText` are new in relation to DOMAIN_MODEL v2.2: the public
/// comparator needs a readable URL (ADR-0004 #13) and an accent-free column to
/// search on (ADR-0010, A4 and A5).
model Product {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ean                  String?         @unique @db.VarChar(14)
  slug                 String          @unique @db.VarChar(160)
  name                 String          @db.VarChar(160)
  brand                String          @db.VarChar(80)
  category             ProductCategory
  variant              String          @db.VarChar(60)
  netWeightGrams       Int             @map("net_weight_grams")
  imageUrl             String?         @map("image_url") @db.VarChar(500)
  requiresPrescription Boolean         @default(false) @map("requires_prescription")
  active               Boolean         @default(true)
  searchText           String          @map("search_text") @db.VarChar(320)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  offers Offer[]

  @@map("products")
}

/// Neighbourhood petshop (DOMAIN_MODEL §Loja). Born minimal on purpose: the
/// comparator reads none of the onboarding columns (`legal_name`, `document`,
/// `psp_recipient_id`, `referral_code`), and they enter with J6/`payments`
/// (ADR-0010, A3).
model Store {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String      @unique @db.VarChar(120)
  name         String      @db.VarChar(120)
  neighborhood String      @db.VarChar(80)
  status       StoreStatus @default(PROSPECT)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  deliveryAreas DeliveryArea[]
  offers        Offer[]

  @@map("stores")
}

/// Where a store delivers and for how much (DOMAIN_MODEL §Área de Entrega).
/// `postal_code_ranges` is JSONB — `[{ from, to }]` of eight digits — because
/// the ranges are values of the area, always read and written with it; a child
/// table would normalise a value object. Whether an area covers an address is
/// decided in `packages/domain`, never in SQL (ADR-0004 #12, ADR-0010 A6/A7).
model DeliveryArea {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  label            String   @db.VarChar(80)
  neighborhoods    String[]
  postalCodeRanges Json     @map("postal_code_ranges")
  deliveryFeeCents Int      @map("delivery_fee_cents")
  estimatedMinutes Int      @map("estimated_minutes")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, label])
  @@index([active])
  @@map("delivery_areas")
}

/// What a store sells, for how much, and whether it is on the shelf
/// (DOMAIN_MODEL §Oferta). The unique pair (store, product) *is* the invariant
/// "one price per store per product" — it is the constraint, not the code, that
/// keeps a second row from appearing.
model Offer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  priceCents     Int      @map("price_cents")
  available      Boolean  @default(true)
  priceUpdatedAt DateTime @map("price_updated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId, available])
  @@map("offers")
}
