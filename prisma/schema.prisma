// Schema do PetDots. Os models derivam do DOMAIN_MODEL (docs/01-product/),
// nunca do marketplace legado (ADR-0002, anti-contaminação).
// Os models nascem a partir da pd-09: `WaitlistEntry` é o primeiro, e com ele
// a primeira migration do projeto. Os demais agregados do DOMAIN_MODEL entram
// junto com a feature que os exercita, nunca antes — `Product`, `Store`,
// `DeliveryArea` e `Offer` entraram na pd-11, com o comparador público, e
// `CommissionRate` ficou de fora porque quem a lê é `orders` (ADR-0010).
// `User` e `RefreshToken` entraram na pd-12, com a autenticação própria;
// `Tutor` não veio junto, porque é perfil de consumo e não identidade
// (ADR-0011, A10). `Tutor` e `Pet` entraram na pd-14, com o perfil do tutor e
// o cadastro de pets — o passo seguinte ao cadastro, não parte dele
// (ADR-0015). `Order`, `OrderItem`, `Refund`, `CommissionRate`,
// `StoreCommissionRate` e `AuditLog` entraram na pd-15, com o pedido sem
// pagamento (ADR-0017): o pedido nasce `PLACED`, a comissão é lida na criação e
// congelada por item, toda saída que não é entrega gera `Refund`, e a
// auto-recusa por prazo é a primeira mutação auditada do projeto. `Payment`,
// `Payout` e `Delivery` continuam fora — entram com o PSP (pd-17) e a entrega;
// `StoreMember` é a pd-16. `ReplenishmentSchedule` e `Reminder` continuam fora:
// quem os lê é a calculadora de consumo (capacidade 9).

generator client {
  provider = "prisma-client-js"
}

// A URL de conexão não vive mais aqui: no Prisma 7 ela é do `prisma.config.ts`
// (para Migrate) e do driver adapter (para o client em runtime). Ver ADR-0007.
datasource db {
  provider = "postgresql"
}

enum WaitlistSource {
  CAMPAIGN
  OUT_OF_AREA
  STORE_QR

  @@map("waitlist_source")
}

/// Smoke-test and out-of-area captures (DOMAIN_MODEL §Lista de Espera).
/// `phone` is the lead's identity: normalised to E.164 by the domain and
/// unique here, so the same person never counts twice (pd-09, A9).
model WaitlistEntry {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String         @db.VarChar(120)
  phone           String         @unique @db.VarChar(16)
  neighborhood    String         @db.VarChar(80)
  postalCode      String         @map("postal_code") @db.Char(8)
  petFoodDeclared String?        @map("pet_food_declared") @db.VarChar(120)
  source          WaitlistSource
  consentAt       DateTime       @map("consent_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@map("waitlist_entries")
}

enum UserRole {
  TUTOR
  STORE_MEMBER
  ADMIN

  @@map("user_role")
}

/// Authenticable identity (DOMAIN_MODEL §Usuário). One human is one row even
/// when they are both a tutor and a shop owner — `roles` is a list precisely
/// because "a identidade é uma só, os papéis se acumulam".
/// `Tutor` (the consumption profile: pets, addresses, schedules) is a separate
/// aggregate, optional and 1:1: registering still creates a `User` and nothing
/// else (ADR-0011 A10), and the profile arrives in a later step (ADR-0015).
/// `phone` is written by that step, through a use case of `identity` — the
/// `tutors` module never touches this table.
model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(16)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  roles        UserRole[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  tutor         Tutor?

  @@map("users")
}

enum PetSpecies {
  DOG
  CAT

  @@map("pet_species")
}

/// Consumption profile of a `User` (DOMAIN_MODEL §Tutor): who to deliver to.
/// One row per identity — `user_id` is unique, which is what makes `PUT
/// /tutors/me` an upsert with nothing to reconcile.
/// `default_address` of the DOMAIN_MODEL is these flat columns and not a child
/// table: the MVP has one address per tutor, `neighborhood` and `postal_code`
/// are queried, and the order stores its own snapshot, so address history never
/// needs a table (ADR-0015). `phone` is not here — it belongs to the identity.
model Tutor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  name         String   @db.VarChar(120)
  street       String   @db.VarChar(160)
  streetNumber String   @map("street_number") @db.VarChar(20)
  complement   String?  @db.VarChar(80)
  neighborhood String   @db.VarChar(80)
  postalCode   String   @map("postal_code") @db.Char(8)
  reference    String?  @db.VarChar(160)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pets   Pet[]
  orders Order[]

  @@map("tutors")
}

/// A tutor's animal (DOMAIN_MODEL §Pet). `id` is the **Pet ID** and is
/// immutable — it is what the phase-2 pet wallet will hang off.
/// `birth_date` is a `DATE` and nullable: many tutors do not know it, and
/// blocking the registration over it would contradict "poucas telas, pouco
/// esforço" (PERSONAS). `weight_grams` is the input the consumption calculator
/// will read (capacidade 9); its `> 0` check is written by hand in the
/// migration, because Prisma does not model check constraints.
model Pet {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId     String     @map("tutor_id") @db.Uuid
  name        String     @db.VarChar(60)
  species     PetSpecies
  birthDate   DateTime?  @map("birth_date") @db.Date
  weightGrams Int        @map("weight_grams")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("pets")
}

/// A refresh token that can be revoked. Persisting it is what makes logout
/// mean something: an access token expires on its own, but a refresh token
/// nobody tracks can never be taken back (AUTHENTICATION, ADR-0011 A7).
/// Only the hash is stored — the column is a credential verifier, not the
/// credential, exactly like `users.password_hash`.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ProductCategory {
  FOOD_STANDARD
  FOOD_PREMIUM
  TREAT
  HYGIENE
  HEALTH_OTC
  ACCESSORY

  @@map("product_category")
}

enum StoreStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED

  @@map("store_status")
}

/// Master catalogue, curated by the platform (DOMAIN_MODEL §Produto). A store
/// never creates a product — it declares an `Offer` over one.
/// `slug` and `searchText` are new in relation to DOMAIN_MODEL v2.2: the public
/// comparator needs a readable URL (ADR-0004 #13) and an accent-free column to
/// search on (ADR-0010, A4 and A5).
model Product {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ean                  String?         @unique @db.VarChar(14)
  slug                 String          @unique @db.VarChar(160)
  name                 String          @db.VarChar(160)
  brand                String          @db.VarChar(80)
  category             ProductCategory
  variant              String          @db.VarChar(60)
  netWeightGrams       Int             @map("net_weight_grams")
  imageUrl             String?         @map("image_url") @db.VarChar(500)
  requiresPrescription Boolean         @default(false) @map("requires_prescription")
  active               Boolean         @default(true)
  searchText           String          @map("search_text") @db.VarChar(320)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  offers Offer[]

  @@map("products")
}

/// Neighbourhood petshop (DOMAIN_MODEL §Loja). Born minimal on purpose: the
/// comparator reads none of the onboarding columns (`legal_name`, `document`,
/// `psp_recipient_id`, `referral_code`), and they enter with J6/`payments`
/// (ADR-0010, A3).
/// `opening_hours` is the weekly schedule ADR-0014 C2 requires, as JSONB —
/// `[{ weekday, opens, closes }]`, several stretches per day for the shop that
/// closes for lunch. Same reasoning as `delivery_areas.postal_code_ranges`: it
/// is a **value** of the store, read whole to answer "está aberta agora?", never
/// queried by SQL. It defaults to `[]`, which means **never open** — failing
/// closed, because a store with no schedule taking an order at 3am is the
/// problem the ADR exists to prevent. Written by the seed today; the `OWNER`
/// edits it in the pd-16 panel (ADR-0013, B4).
model Store {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String      @unique @db.VarChar(120)
  name         String      @db.VarChar(120)
  neighborhood String      @db.VarChar(80)
  status       StoreStatus @default(PROSPECT)
  openingHours Json        @default("[]") @map("opening_hours")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  deliveryAreas   DeliveryArea[]
  offers          Offer[]
  orders          Order[]
  commissionRates StoreCommissionRate[]

  @@map("stores")
}

/// Where a store delivers and for how much (DOMAIN_MODEL §Área de Entrega).
/// `postal_code_ranges` is JSONB — `[{ from, to }]` of eight digits — because
/// the ranges are values of the area, always read and written with it; a child
/// table would normalise a value object. Whether an area covers an address is
/// decided in `packages/domain`, never in SQL (ADR-0004 #12, ADR-0010 A6/A7).
model DeliveryArea {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  label            String   @db.VarChar(80)
  neighborhoods    String[]
  postalCodeRanges Json     @map("postal_code_ranges")
  deliveryFeeCents Int      @map("delivery_fee_cents")
  estimatedMinutes Int      @map("estimated_minutes")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, label])
  @@index([active])
  @@map("delivery_areas")
}

/// What a store sells, for how much, and whether it is on the shelf
/// (DOMAIN_MODEL §Oferta). The unique pair (store, product) *is* the invariant
/// "one price per store per product" — it is the constraint, not the code, that
/// keeps a second row from appearing.
model Offer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  priceCents     Int      @map("price_cents")
  available      Boolean  @default(true)
  priceUpdatedAt DateTime @map("price_updated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId, available])
  @@map("offers")
}

enum OrderStatus {
  PLACED
  ACCEPTED
  DISPATCHED
  DELIVERED
  REJECTED
  CANCELLED

  @@map("order_status")
}

enum AcquisitionChannel {
  PLATFORM
  STORE_REFERRAL

  @@map("acquisition_channel")
}

enum ItemFulfillment {
  FULFILLED
  SUBSTITUTED
  UNAVAILABLE

  @@map("item_fulfillment")
}

enum OrderRejectionReason {
  STORE_REJECTED
  ACCEPTANCE_EXPIRED

  @@map("order_rejection_reason")
}

enum RefundReason {
  STORE_REJECTED
  ACCEPTANCE_EXPIRED
  TUTOR_CANCELLED
  STORE_CANCELLED
  ITEM_UNAVAILABLE

  @@map("refund_reason")
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("refund_status")
}

enum AuditActorKind {
  USER
  SYSTEM

  @@map("audit_actor_kind")
}

/// The take rate by category, historised (DOMAIN_MODEL §Taxa de Comissão).
/// Owned by `catalog`, because it is the **category** that carries the rate
/// (ADR-0004 #4). Historised because the table will be recalibrated with field
/// data — ADR-0003 records the ranges as "hipóteses, não tabela final" — and a
/// past order must keep being priced by the rate that was in force when it was
/// placed. `valid_from` inclusive, `valid_to` exclusive; null means in force.
model CommissionRate {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  ProductCategory
  rateBps   Int             @map("rate_bps")
  validFrom DateTime        @map("valid_from") @db.Timestamptz
  validTo   DateTime?       @map("valid_to") @db.Timestamptz
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([category, validFrom])
  @@map("commission_rates")
}

/// One store's exception to the table — the founder tariff (DOMAIN_MODEL
/// §Comissão Especial). Owned by `stores`, as SYSTEM_ARCHITECTURE distributes
/// it. Cascade on delete: an exception belonging to a store that no longer
/// exists is not a record worth keeping, unlike an order.
model StoreCommissionRate {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String          @map("store_id") @db.Uuid
  category  ProductCategory
  rateBps   Int             @map("rate_bps")
  validFrom DateTime        @map("valid_from") @db.Timestamptz
  validTo   DateTime?       @map("valid_to") @db.Timestamptz
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, category, validFrom])
  @@map("store_commission_rates")
}

/// A purchase from **one** store (DOMAIN_MODEL §Pedido). An accounting record:
/// it carries the frozen picture of prices, fees and commission at the moment
/// of the purchase, and a later change to a price or to the commission table
/// never alters it (ADR-0004 #5).
///
/// 🔴 Both foreign keys are `Restrict`, not `Cascade`: an order is a fiscal
/// record, and deleting a tutor or a store must not delete it. The consequence
/// is deliberate and registered — deleting an account that has ordered now
/// fails at the database, and capacidade 14 (exclusão a pedido do titular)
/// anonymises the snapshot columns instead of removing the row (SECURITY §LGPD).
///
/// `status` starts at `PLACED` because there is no payment yet (ADR-0017): the
/// pre-payment state and the `→ PLACED` after the PSP webhook are pd-17.
/// `acceptance_deadline_at` is persisted rather than recomputed — it is a
/// snapshot of the schedule at the instant of the order, so editing the store's
/// hours afterwards cannot move the deadline of an order already placed, and
/// the sweeper becomes an indexed `WHERE` instead of a per-order recomputation.
model Order {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                @unique @db.VarChar(6)
  tutorId              String                @map("tutor_id") @db.Uuid
  storeId              String                @map("store_id") @db.Uuid
  status               OrderStatus           @default(PLACED)
  acquisitionChannel   AcquisitionChannel    @default(PLATFORM) @map("acquisition_channel")
  idempotencyKey       String                @map("idempotency_key") @db.Uuid
  contactName          String                @map("contact_name") @db.VarChar(120)
  contactPhone         String                @map("contact_phone") @db.VarChar(16)
  deliveryAddress      Json                  @map("delivery_address")
  itemsTotalCents      Int                   @map("items_total_cents")
  deliveryFeeCents     Int                   @map("delivery_fee_cents")
  serviceFeeCents      Int                   @map("service_fee_cents")
  totalCents           Int                   @map("total_cents")
  commissionTotalCents Int                   @map("commission_total_cents")
  placedAt             DateTime              @map("placed_at") @db.Timestamptz
  acceptanceDeadlineAt DateTime              @map("acceptance_deadline_at") @db.Timestamptz
  acceptedAt           DateTime?             @map("accepted_at") @db.Timestamptz
  dispatchedAt         DateTime?             @map("dispatched_at") @db.Timestamptz
  deliveredAt          DateTime?             @map("delivered_at") @db.Timestamptz
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz
  rejectedAt           DateTime?             @map("rejected_at") @db.Timestamptz
  rejectionReason      OrderRejectionReason? @map("rejection_reason")
  cancellationReason   String?               @map("cancellation_reason") @db.VarChar(200)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  tutor   Tutor       @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  refunds Refund[]

  @@unique([tutorId, idempotencyKey])
  @@index([storeId, status, placedAt])
  @@index([tutorId, placedAt(sort: Desc)])
  @@index([status, acceptanceDeadlineAt])
  @@map("orders")
}

/// One line of an order, with the **snapshot** of the product, the price and
/// the commission applied (DOMAIN_MODEL §Item do Pedido).
///
/// 🔴 `product_id` and `offer_id` carry **no foreign key**, on purpose. The
/// snapshot is what makes the order readable without consulting another
/// module's tables (CODING_STANDARDS: a module never JOINs across a boundary),
/// and a product withdrawn from the catalogue must not drag an accounting
/// record with it. The ids are kept so the pd-17 payout and a future support
/// screen can trace back — not so the database can join.
///
/// `fulfillment` is the only column the store ever changes: marking an item
/// unavailable moves the line out of what will be delivered **without editing
/// the snapshot**, and a `Refund` carries the money back (ADR-0014, C3).
model OrderItem {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                   String          @map("order_id") @db.Uuid
  productId                 String          @map("product_id") @db.Uuid
  offerId                   String          @map("offer_id") @db.Uuid
  productNameSnapshot       String          @map("product_name_snapshot") @db.VarChar(160)
  productVariantSnapshot    String          @map("product_variant_snapshot") @db.VarChar(60)
  categorySnapshot          ProductCategory @map("category_snapshot")
  unitPriceCents            Int             @map("unit_price_cents")
  quantity                  Int
  commissionRateBpsSnapshot Int             @map("commission_rate_bps_snapshot")
  commissionAmountCents     Int             @map("commission_amount_cents")
  fulfillment               ItemFulfillment @default(FULFILLED)
  substitutedByProductId    String?         @map("substituted_by_product_id") @db.Uuid
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// The way back for the money (DOMAIN_MODEL §Devolução, ADR-0014 C5). A **new
/// record, never an edit** of the payment — that is what keeps the order an
/// accounting record under fiscal retention.
///
/// ⚠️ `payment_id` is nullable and carries **no foreign key**, because
/// `payments` does not exist yet: in pd-15 no order is ever paid, so every row
/// here records "what would be given back for an order that was never charged".
/// The column's FK is pd-17, and so is the decision about what to do with these
/// development-only rows (ADR-0017).
/// `order_item_id` is null on a total refund and names the line on a partial
/// one; `order_id` is `Restrict` for the same reason the order is.
model Refund {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String?      @map("payment_id") @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  orderItemId String?      @map("order_item_id") @db.Uuid
  reason      RefundReason
  amountCents Int          @map("amount_cents")
  status      RefundStatus @default(PENDING)
  pspRefundId String?      @unique @map("psp_refund_id") @db.VarChar(120)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime?    @map("completed_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refunds")
}

/// Who changed what, and when (SECURITY §Auditoria).
///
/// 🔴 Singular on purpose — a deliberate exception to the plural table rule of
/// NAMING_CONVENTIONS. `audit_log` is the name SECURITY, SYSTEM_ARCHITECTURE
/// and QUALITY_ATTRIBUTES have used since the foundation, and renaming the
/// canonical term to satisfy a convention would cost more than the exception.
///
/// Written by the **application, through a port**, inside the same transaction
/// as the state transition — not by an HTTP interceptor (ADR-0017). The first
/// audited refusal of this project is the auto-rejection by deadline, performed
/// by a job with no request behind it, which an interceptor could never see.
///
/// `actor_user_id` has no foreign key: the trail must outlive the account.
/// `payload` carries **ids, states and reasons only** — never a name, a phone
/// or an address (NAMING_CONVENTIONS §Logs).
model AuditLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKind   AuditActorKind @map("actor_kind")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      String         @db.VarChar(60)
  entityType  String         @map("entity_type") @db.VarChar(40)
  entityId    String         @map("entity_id") @db.Uuid
  storeId     String?        @map("store_id") @db.Uuid
  payload     Json
  requestId   String?        @map("request_id") @db.VarChar(64)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
