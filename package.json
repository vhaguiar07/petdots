{
  "name": "petdots",
  "private": true,
  "version": "0.1.0",
  "description": "PetDots — monorepo do ecossistema digital pet",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "contract:write": "npm run build && npm run contract:write -w @petdots/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "otel:up": "docker compose --profile observability up -d otel-collector",
    "otel:down": "docker compose --profile observability stop otel-collector",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "protobufjs": false,
    "ssh2": false,
    "unrs-resolver": false
  }
}
