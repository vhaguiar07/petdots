# Copie para .env e ajuste. Nunca commitar o .env real.
# O Postgres local sobe com `npm run db:up` (docker-compose.yml, porta 5437).

DATABASE_URL=postgresql://petdots:petdots@localhost:5437/petdots?schema=public
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Chave que assina o access token (pd-12). OBRIGATORIA e sem default: segredo
# com default e segredo que vai para producao. Minimo de 32 caracteres. A API
# se recusa a subir sem ela, nomeando a variavel e sem ecoar o valor.
# GERE A SUA — o valor abaixo e de EXEMPLO e nao serve para nada real:
#   openssl rand -base64 48
JWT_SECRET=exemplo-nao-use-troque-por-openssl-rand-base64-48

# Vida do access token, na notacao do @nestjs/jwt (15m, 1h, 7d). Curta de
# proposito: ele expira sozinho, sem consulta ao banco. Quem se revoga de
# verdade e o refresh token, que fica persistido em refresh_tokens.
JWT_EXPIRATION_TIME=15m

# Vida do refresh token, em dias. Ele e rotacionado a cada uso: renovar invalida
# o anterior, e o logout revoga o corrente.
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Prazo que a loja tem para aceitar um pedido, em minutos. O relogio so corre em
# horario de funcionamento (ADR-0014, C2): um pedido as 18h55 numa loja que
# fecha as 19h nao vence as 19h10 — ele retoma a contagem na abertura seguinte.
# Opcional; o default abaixo e o do ADR e nao precisa estar no seu .env.
# ACCEPTANCE_WINDOW_MINUTES=15

# Intervalo da varredura que auto-recusa pedidos com prazo vencido, em
# milissegundos. Opcional, default 60000. Use `0` para DESLIGAR — e o que voce
# quer quando esta testando com pedidos no banco local e nao quer que eles
# expirem no meio do teste. Ja fica desligada sozinha sob NODE_ENV=test.
# ORDER_EXPIRY_SWEEP_INTERVAL_MS=60000

# Quantos proxies reversos existem entre quem chama e o processo da API.
# Zero (o default) significa "nada na frente", que e a verdade no seu micro. Em
# producao o valor e 1, para a borda do Railway.
# ATENCAO: e disto que depende o rate limit funcionar. Deixado em zero atras de
# um proxy, req.ip e o proxy para todo mundo e as quatro rotas limitadas passam
# a dividir um balde so entre todos os visitantes do planeta.
# TRUST_PROXY_HOPS=0

# Origens de navegador autorizadas a chamar a API, separadas por virgula. Sem
# esta variavel o CORS fica desligado — que e o comportamento correto para um
# cliente servidor-a-servidor. O cliente universal (`@petdots/app`) roda em
# http://localhost:8081 no `expo start`.
CORS_ORIGINS=http://localhost:8081

# Endereco da API visto pela LANDING (`@petdots/landing`, porta 3002). Quem le
# esta variavel e o SERVIDOR do Next, dentro da Server Action — nunca o
# navegador —, por isso ela nao tem prefixo NEXT_PUBLIC_ e a URL interna nao
# vaza para o cliente. Em desenvolvimento o default abaixo ja basta; no deploy a
# plataforma injeta o valor.
# PETDOTS_API_URL=http://localhost:3001

# Se o comparador de precos e ANUNCIADO na landing: os dois links da home, as
# URLs no sitemap.xml e o index do buscador. As rotas /precos respondem de todo
# jeito — isto governa descoberta, nao a feature (ADR-0020, E9).
# Em desenvolvimento ja vem ligado sozinho; em producao fica DE FORA ate o censo
# trocar as oito lojas ficticias do seed (item 3b do BACKLOG). Esquecer a
# variavel esconde o comparador, nunca o expoe.
# PETDOTS_COMPARADOR_PUBLICO=true

# Endereco publico da landing. Usado onde a URL precisa ser absoluta: o
# sitemap.xml, o robots.txt e a canonical das paginas de produto do comparador.
# Errar esta variavel no deploy faz o buscador indexar o endereco errado. Em
# desenvolvimento o default (http://localhost:3002) ja basta.
# PETDOTS_SITE_URL=http://localhost:3002

# Observabilidade (opcional). Sem OTEL_EXPORTER_OTLP_ENDPOINT o SDK nao sobe, e
# a API loga o motivo no boot. Coletor local: `npm run otel:up` (porta 4318).
# O endpoint e a base, sem /v1/traces — a API acrescenta o caminho do sinal.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=petdots-api
# OTEL_SDK_DISABLED=false

# Chave de API do servico gerenciado, quando houver um. NUNCA commitar o valor
# real: o formato e `chave1=valor1,chave2=valor2` (spec do OTLP).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <sua-chave-aqui>
