// Prisma schema - PetDots Marketplace
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STORE_OWNER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  name          String
  phone         String?
  role          UserRole @default(CUSTOMER)
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens  RefreshToken[]
  stores         Store[]
  orders         Order[]
  addresses      Address[]
  auditLogs      AuditLog[]
  productReviews ProductReview[]
  storeReviews   StoreReview[]
  priceAlerts    PriceAlert[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  revoked    Boolean  @default(false)
  replacedBy String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------------

enum StoreStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model Store {
  id                  String               @id @default(cuid())
  ownerId             String
  name                String
  slug                String               @unique
  description         String?
  logoUrl             String?
  coverUrl            String?
  street              String?
  number              String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?
  latitude            Float?
  longitude           Float?
  deliveryProvider    DeliveryProviderType @default(SELF)
  deliveryTimeMinutes Int?
  deliveryRadiusKm    Float                @default(10)
  phone               String?
  whatsapp            String?
  instagram           String?
  businessHours       Json?
  status              StoreStatus          @default(PENDING_APPROVAL)
  avgRating           Float                @default(0)
  reviewCount         Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  owner                  User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdCatalogProducts CatalogProduct[] @relation("StoreCreatedCatalogProducts")
  storeProducts          StoreProduct[]
  promotions             Promotion[]
  orders                 Order[]
  reviews                StoreReview[]

  @@index([ownerId])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  catalogProducts CatalogProduct[]

  @@map("categories")
}

model PetType {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  catalogProducts CatalogProduct[]

  @@map("pet_types")
}

// ---------------------------------------------------------------------------
// Shared Product Catalog
// ---------------------------------------------------------------------------

enum CatalogProductStatus {
  ACTIVE
  PENDING_REVIEW
  REJECTED
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CatalogProduct[]

  @@map("brands")
}

// Produto global do catálogo — existe uma única vez, independente de loja.
// Qualquer lojista pode criar um produto aqui; outros lojistas reaproveitam
// via StoreProduct, definindo apenas preço, estoque e descrição customizada.
model CatalogProduct {
  id               String               @id @default(cuid())
  createdByStoreId String
  categoryId       String?
  petTypeId        String?
  brandId          String?
  name             String
  barcode          String?              @unique
  description      String?
  status           CatalogProductStatus @default(PENDING_REVIEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  createdByStore Store               @relation("StoreCreatedCatalogProducts", fields: [createdByStoreId], references: [id], onDelete: Restrict)
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  petType        PetType?            @relation(fields: [petTypeId], references: [id], onDelete: SetNull)
  brand          Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         CatalogProductImage[]
  storeProducts  StoreProduct[]
  priceAlerts    PriceAlert[]

  @@index([createdByStoreId])
  @@index([categoryId])
  @@index([petTypeId])
  @@index([brandId])
  @@map("catalog_products")
}

model CatalogProductImage {
  id               String   @id @default(cuid())
  catalogProductId String
  url              String
  position         Int      @default(0)
  createdAt        DateTime @default(now())

  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  @@index([catalogProductId])
  @@map("catalog_product_images")
}

// Oferta de um lojista para um produto do catálogo global.
// Cada loja define seu próprio preço, estoque e descrição customizada.
model StoreProduct {
  id                String   @id @default(cuid())
  storeId           String
  catalogProductId  String
  price             Decimal  @db.Decimal(10, 2)
  stock             Int      @default(0)
  customDescription String?
  isActive          Boolean  @default(true)
  avgRating         Float    @default(0)
  reviewCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)
  promotions     Promotion[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  priceHistory   PriceHistory[]

  @@unique([storeId, catalogProductId])
  @@index([storeId])
  @@index([catalogProductId])
  @@map("store_products")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id               String       @id @default(cuid())
  storeId          String
  storeProductId   String?
  name             String
  discountType     DiscountType
  value            Decimal      @db.Decimal(10, 2)
  code             String?
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean      @default(true)
  highlighted      Boolean      @default(false)
  highlightMessage String?
  createdAt        DateTime     @default(now())

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeProductId])
  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Orders / Delivery
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  customerId    String
  storeId       String
  addressId     String
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(10, 2)
  discountTotal Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  couponCode    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer       User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  address        Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  delivery       Delivery?
  productReviews ProductReview[]
  storeReviews   StoreReview[]

  @@index([customerId])
  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  storeProductId String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

enum DeliveryProviderType {
  SELF
  EXTERNAL
}

enum DeliveryStatus {
  WAITING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Delivery {
  id           String               @id @default(cuid())
  orderId      String               @unique
  provider     DeliveryProviderType
  externalId   String?
  status       DeliveryStatus       @default(WAITING)
  courierName  String?
  courierPhone String?
  trackingData Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model ProductReview {
  id             String    @id @default(cuid())
  storeProductId String
  customerId     String
  orderId        String
  rating         Int
  comment        String?
  ownerReply     String?
  ownerRepliedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  customer     User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeProductId, customerId])
  @@index([storeProductId])
  @@map("product_reviews")
}

model StoreReview {
  id             String    @id @default(cuid())
  storeId        String
  customerId     String
  orderId        String
  rating         Int
  comment        String?
  ownerReply     String?
  ownerRepliedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerId])
  @@index([storeId])
  @@map("store_reviews")
}

// ---------------------------------------------------------------------------
// Price History & Alerts
// ---------------------------------------------------------------------------

model PriceHistory {
  id             String   @id @default(cuid())
  storeProductId String
  price          Decimal  @db.Decimal(10, 2)
  recordedAt     DateTime @default(now())

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@index([storeProductId, recordedAt])
  @@map("price_history")
}

model PriceAlert {
  id               String    @id @default(cuid())
  userId           String
  catalogProductId String
  targetPrice      Decimal   @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogProductId])
  @@index([catalogProductId, isActive])
  @@map("price_alerts")
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
