{
  "name": "@petdots/api",
  "version": "0.1.0",
  "private": true,
  "description": "PetDots API — Modular Monolith em NestJS",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "node scripts/dev.mjs",
