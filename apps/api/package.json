    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "12.0.1",
    "@petdots/config": "*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
